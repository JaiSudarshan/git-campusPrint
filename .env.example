# Copy this file to ".env" (same folder as main.py) and fill it in.
# ".env" is git-ignored, so your secrets never reach GitHub.

SECRET_KEY=put-a-long-random-string-here
RUNNER_PASSWORD=choose-a-runner-password

# Leave the next three EMPTY while developing: the app then uses a local
# SQLite database and saves files in ./local_uploads.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads
